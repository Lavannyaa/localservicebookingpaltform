# LocalServe Platform Backend Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/localserve_db

# JWT Authentication
JWT_SECRET=localserve_super_secure_jwt_secret_key_2026_production_auth
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (Configure in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the frontend callback URI registered in Google Cloud Console.
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/oauth/callback
# Used only by the legacy Passport callback flow.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email Verification (Nodemailer SMTP Configuration)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="LocalServe Support" <no-reply@localserve.in>

# Frontend Client URL for CORS & OAuth Redirects
CLIENT_URL=http://localhost:5173
